# Live-bot dashboard image: the web frontend (built with Node) served by the FastAPI backend.
#   docker build -f Dockerfile.dashboard -t coinmon-dashboard .
FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim AS build
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir --prefix=/install ".[dashboard]"

FROM python:3.12-slim
WORKDIR /app
COPY --from=build /install /usr/local
COPY --from=web /web/dist ./web/dist
# Config is env-driven (COINMON_*), mapped to k8s ConfigMaps/Secrets. PANIC needs the agent key.
EXPOSE 8502
ENTRYPOINT ["coinmon", "dashboard", "--host", "0.0.0.0", "--port", "8502"]
