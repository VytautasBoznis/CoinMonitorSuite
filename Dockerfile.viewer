# Candle viewer image (Streamlit). Built from the repo root:
#   docker build -f Dockerfile.viewer -t coinmon-viewer .
FROM python:3.12-slim AS build
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir --prefix=/install ".[viewer]"

FROM python:3.12-slim
WORKDIR /app
COPY --from=build /install /usr/local
# streamlit needs a script path; the coinmon package itself is on the path from /install.
COPY src/coinmon/viewer/app.py ./app.py
# Config is env-driven (COINMON_*), mapped to k8s ConfigMaps/Secrets.
EXPOSE 8501
ENTRYPOINT ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501"]
